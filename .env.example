# Application
APP_ENV=development
# Swagger UI /docs and ReDoc /redoc. Blank = on in development/test, off in staging/production.
# API_DOCS_ENABLED=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
API_MAX_REQUEST_BODY_BYTES=1048576

# OpenRouter: leave the key and model IDs blank until explicitly configured.
OPENROUTER_API_KEY=
# LLM calls (planner + report analyst summary) only happen when this is true.
OPENROUTER_LIVE_ENABLED=false
ALLOW_PAID_MODELS=false
# Set PRIMARY_FREE_MODEL=auto to pick the fastest working OpenRouter ":free" model
# automatically (probed, cached 6h on disk, re-checked after expiry, falls back
# to the next free model on failure). Or set an explicit "<id>:free".
PRIMARY_FREE_MODEL=
OPENROUTER_FREE_MODEL_CACHE_PATH=data/openrouter_free_models.json
OPENROUTER_FREE_MODEL_CACHE_TTL_SECONDS=21600
FALLBACK_FREE_MODEL_1=
FALLBACK_FREE_MODEL_2=

# Planner selection — explicit, not derived from OPENROUTER_LIVE_ENABLED.
# Valid values: deterministic, llm
PLANNER_MODE=deterministic

# Planner mode prerequisites for LLM mode:
# LLM mode (PLANNER_MODE=llm) requires ALL of:
#   OPENROUTER_LIVE_ENABLED=true
#   PRIMARY_FREE_MODEL=<non-empty free-model identifier>
#   OPENROUTER_API_KEY=<configured>
#   ALLOW_PAID_MODELS=false
#
# LLM mode fails closed when prerequisites are missing.
# Planner mode is selected at application startup/composition.

# Infrastructure: blank values are safe; adapters arrive in later phases.
DATABASE_URL=
REDIS_URL=

# Optional free-tier provider adapters; the platform must not require these.
# Optional SECOND live market source (after Yahoo). Free key: alphavantage.co.
# Free tier = 25 requests/day: responses are cached 12h and a daily budget is
# persisted to ALPHA_VANTAGE_BUDGET_PATH. US tickers + Indian stocks via BSE.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_CACHE_TTL_SECONDS=43200
ALPHA_VANTAGE_BUDGET_PATH=data/alpha_vantage_budget.json
# Reserved; no Finnhub adapter is wired (Yahoo + Alpha Vantage cover US/India).
FINNHUB_API_KEY=

# Planned external-call safety defaults. Application validation comes later.
HTTP_TIMEOUT_SECONDS=30
MAX_HTTP_RETRIES=2

# Phase 3 market freshness/cache policy (fixture-backed by default).
MARKET_STALE_AFTER_HOURS=72
MARKET_CACHE_TTL_SECONDS=300

# Optional live market acquisition (Yahoo chart HTTP). Default OFF so local/CI
# remain offline and $0. When enabled, fixture remains secondary fallback.
MARKET_DATA_LIVE_ENABLED=false
MARKET_DATA_PRIMARY_PROVIDER=yahoo_finance_chart
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_MAX_RESPONSE_BYTES=1048576
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_HISTORY_DAYS=30

# Phase 4 financial freshness/cache policy (fixture-backed by default).
FINANCIAL_CACHE_TTL_SECONDS=3600

# REQUIRED for any live SEC data (companyfacts + SEC litigation feed).
# SEC rejects anonymous requests (HTTP 403). Put YOUR name and email here:
#   SEC_USER_AGENT=Your Name your.email@example.com
# Use a REAL mailbox: SEC returns 403 for GitHub noreply addresses
# (…@users.noreply.github.com) and other noreply/no-reply emails.
# If empty, live SEC data is disabled with a warning and sample data is used.
SEC_USER_AGENT=
# Optional live SEC companyfacts acquisition. Default OFF so local/CI remain offline.
FINANCIAL_DATA_LIVE_ENABLED=false
# Live India fundamentals (NSE/BSE companies) via Yahoo fundamentals timeseries, no key.
# Unofficial aggregator (Tier 2). Only used when FINANCIAL_DATA_LIVE_ENABLED=true;
# otherwise Indian fundamentals come from the labelled fixture sample (Reliance only).
INDIA_FUNDAMENTALS_LIVE_ENABLED=true
FINANCIAL_DATA_PRIMARY_PROVIDER=sec_company_facts
FINANCIAL_DATA_TIMEOUT_SECONDS=15
FINANCIAL_DATA_MAX_RESPONSE_BYTES=16777216
# Phase 5 qualitative cache policy (fixture-backed; live providers deferred).
NEWS_CACHE_TTL_SECONDS=900
INDUSTRY_CACHE_TTL_SECONDS=3600
REGULATORY_CACHE_TTL_SECONDS=3600
# Unset = follow MARKET_DATA_LIVE_ENABLED (NSE/BSE quotes on with live data,
# falling back to Yahoo/fixtures safely). Set true/false to override.
# INDIA_LIVE_QUOTES_ENABLED=true
INDIA_QUOTES_MIN_INTERVAL_SECONDS=1.0
INDIA_QUOTE_CACHE_TTL_SECONDS=15
# Company universe beyond the ~10 demo issuers (BSE equity list for India,
# SEC tickers for US; US needs SEC_USER_AGENT). Unset = follow
# MARKET_DATA_LIVE_ENABLED. Lists are cached 24h in COMPANY_UNIVERSE_CACHE_DIR.
# COMPANY_UNIVERSE_LIVE_ENABLED=true
COMPANY_UNIVERSE_CACHE_DIR=data/universe
INDIA_FILINGS_LIVE_ENABLED=false
INDIA_FILINGS_LOOKBACK_DAYS=30
INDIA_FILINGS_CACHE_TTL_SECONDS=900
LIVE_NEWS_ENABLED=false
LIVE_NEWS_SOURCES=gdelt,google_news,company_ir
NEWS_IR_RSS_FEEDS=
LIVE_NEWS_MIN_INTERVAL_SECONDS=2.0
LIVE_NEWS_LOOKBACK_DAYS=7
LIVE_NEWS_CACHE_TTL_SECONDS=900
LIVE_REGULATORY_ENABLED=false
LIVE_REGULATORY_SOURCES=sec,sebi
LIVE_REGULATORY_LOOKBACK_DAYS=365
LIVE_REGULATORY_CACHE_TTL_SECONDS=1800
STORAGE_BACKEND=memory
SQLITE_PATH=data/financial_intelligence.sqlite3

# Phase 11.2 — API-key authentication.
# AUTH_ENABLED controls whether inbound requests must supply a valid Bearer key.
# In production and staging, AUTH_ENABLED=false is rejected at startup (fail-closed).
# In development and test, auth is bypassed unless API_KEYS is set AND AUTH_ENABLED=true
# (then Bearer keys are enforced locally too). Without keys, bind to 127.0.0.1 only.
# API_KEYS is a comma-separated list of opaque secret Bearer keys.
# Keys are stored in process memory only; persistent storage belongs to a later phase.
# Never commit a real key here. Configure keys via environment variables or secrets.
AUTH_ENABLED=true
API_KEYS=
